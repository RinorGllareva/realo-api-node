# Server
PORT=3000
CORS_ORIGINS=https://realo-realestate.com,https://www.realo-realestate.com,http://localhost:8080


# SQL Server — real values go only in .env (never commit them)
SQLSERVER_URL=Server=YOUR_HOST,1433;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=true;

# Admin login (required: the dashboard cannot sign in or save anything without these)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional extra secret for signing login tokens (any long random string)
ADMIN_TOKEN_SECRET=
